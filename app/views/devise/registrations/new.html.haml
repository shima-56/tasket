.signupPage
  .titleArea
    %h1 アカウントを新規作成
    .m-3
    = render 'devise/shared/links'
  .container
    = form_with scope: resource, as: resource_name, url: registration, url: registration_path(resource_name), html: { class: "mt-5, signupForm" }, local: true do |f|
      = devise_error_messages!
      .form-group
        = form-group
          = f.label :name
          = f.text_field :name, class: "form-control", placeholder: "ニックネームを教えてください"
        = form-group
        = form-group
        = form-group
